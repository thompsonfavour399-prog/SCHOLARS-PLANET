<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title or "Scholars Planet | Scholarships, Grants, Fellowships & Free Learning" }}</title>
<meta name="description" content="{{ description or summary or 'Scholars Planet shares verified scholarships, grants, fellowships, competitions and free learning resources for students, with deadlines you can trust.' }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
{% if noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}
<meta property="og:title" content="{{ title or 'Scholars Planet' }}">
<meta property="og:description" content="{{ description or summary or 'Verified scholarships, grants, fellowships and free learning resources.' }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/assets/img/hero-graduate.jpg">
<meta name="theme-color" content="#0B1F3A">
<link rel="icon" href="/assets/img/logo-mono.png">
<link rel="alternate" type="application/rss+xml" title="Scholars Planet: latest opportunities" href="/feed.xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/style.css">
</head>
<body class="{{ bodyClass }}">

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <symbol id="i-fb" viewBox="0 0 24 24"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z"/></symbol>
    <symbol id="i-ig" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.3" cy="6.7" r="1.2"/></symbol>
    <symbol id="i-wa" viewBox="0 0 24 24"><path d="M12.04 2a9.9 9.9 0 0 0-8.5 14.95L2 22l5.2-1.5A9.95 9.95 0 1 0 12.04 2zm5.8 14.1c-.24.69-1.4 1.3-1.94 1.35-.5.05-1.12.07-1.8-.11-.42-.13-.95-.31-1.64-.6-2.88-1.24-4.76-4.13-4.9-4.32-.14-.19-1.17-1.56-1.17-2.97 0-1.42.74-2.12 1-2.41.26-.29.57-.36.76-.36l.55.01c.18 0 .42-.07.65.5.24.58.82 2 .89 2.15.07.14.12.31.02.5-.1.19-.14.31-.29.48-.14.17-.3.37-.43.5-.14.14-.29.3-.12.58.17.29.74 1.22 1.6 1.98 1.1.98 2.03 1.28 2.32 1.43.29.14.46.12.63-.07.17-.19.72-.84.91-1.13.19-.29.38-.24.65-.14.26.1 1.67.79 1.96.93.29.14.48.22.55.34.07.12.07.7-.17 1.39z"/></symbol>
    <symbol id="i-menu" viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol>
    <symbol id="i-close" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol>
    <symbol id="i-bookmark" viewBox="0 0 24 24"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4.5L5 21V4a1 1 0 0 1 1-1z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></symbol>
    <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M20 20l-3.5-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol>
    <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
    <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 7v5l3 2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol>
    <symbol id="i-copy" viewBox="0 0 24 24"><rect x="9" y="9" width="12" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1" fill="none" stroke="currentColor" stroke-width="2"/></symbol>
    <symbol id="i-link" viewBox="0 0 24 24"><path d="M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol>
    <symbol id="i-trophy" viewBox="0 0 24 24"><path d="M8 4h8v5a4 4 0 0 1-8 0V4zM8 6H5v2a3 3 0 0 0 3 3M16 6h3v2a3 3 0 0 1-3 3M12 13v4M8 21h8M10 17h4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
    <symbol id="i-book" viewBox="0 0 24 24"><path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2V5zM4 19a2 2 0 0 1 2-2h13" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></symbol>
    <symbol id="i-cap" viewBox="0 0 24 24"><path d="M2 9l10-5 10 5-10 5L2 9zM6 11.5V16c0 1.5 3 3 6 3s6-1.5 6-3v-4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></symbol>
  </defs>
</svg>

<header class="topbar">
  <div class="wrap topbar-in">
    <a class="brand" href="/" aria-label="Scholars Planet home">
      <img src="/assets/img/logo-mono.png" alt="" width="40" height="32">
      <span>Scholars Planet</span>
    </a>
    <nav class="nav" aria-label="Main">
      <a href="/opportunities/" class="{{ 'current' if page.url == '/opportunities/' }}">Opportunities</a>
      <a href="/materials/" class="{{ 'current' if page.url == '/materials/' }}">Materials</a>
      <a href="/award-notifications/" class="{{ 'current' if page.url == '/award-notifications/' }}">Award Notifications</a>
      <a href="/saved/" class="{{ 'current' if page.url == '/saved/' }}">Saved <span class="count js-saved-count" hidden>0</span></a>
      <a href="/about/" class="{{ 'current' if page.url == '/about/' }}">About</a>
    </nav>
    <div class="topbar-actions">
      <a class="btn btn-sm hide-sm" href="{{ site.whatsapp }}" target="_blank" rel="noopener"><svg class="ic"><use href="#i-wa"/></svg> Join channel</a>
      <button class="menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu"><svg class="ic ic-lg"><use href="#i-menu"/></svg></button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" hidden>
  <div class="mobile-menu-in">
    <p class="mm-intro">Where would you like to go?</p>
    <a class="mm-item" href="/opportunities/"><b>Opportunities</b><span>Scholarships, grants, fellowships, competitions and more, sorted by nearest deadline.</span></a>
    <a class="mm-item" href="/materials/"><b>Materials</b><span>Free learning platforms, tools and study resources.</span></a>
    <a class="mm-item" href="/award-notifications/"><b>Award Notifications</b><span>Winners and results of scholarships and contests.</span></a>
    <a class="mm-item" href="/saved/"><b>Saved <span class="count js-saved-count" hidden>0</span></b><span>Opportunities you bookmarked on this device.</span></a>
    <a class="mm-item" href="/about/"><b>About Scholars Planet</b><span>Our mission, story and how we serve students.</span></a>
    <a class="mm-item" href="/privacy-policy/"><b>Privacy Policy</b><span>How we handle your information.</span></a>
    <div class="mm-social">
      <a class="btn" href="{{ site.whatsapp }}" target="_blank" rel="noopener"><svg class="ic"><use href="#i-wa"/></svg> WhatsApp</a>
      <a class="btn btn-ghost" href="{{ site.facebook }}" target="_blank" rel="noopener"><svg class="ic"><use href="#i-fb"/></svg> Facebook</a>
      <a class="btn btn-ghost" href="{{ site.instagram }}" target="_blank" rel="noopener"><svg class="ic"><use href="#i-ig"/></svg> Instagram</a>
    </div>
  </div>
</div>

<main id="main">
{{ content | safe }}
</main>

<footer class="footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <a class="brand brand-light" href="/"><img src="/assets/img/logo-mono.png" alt="" width="40" height="32"><span>Scholars Planet</span></a>
      <p>{{ site.tagline }}. Verified opportunities for students across Nigeria and Africa.</p>
      <p class="footer-mail"><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      <div class="social-row">
        <a href="{{ site.whatsapp }}" target="_blank" rel="noopener" aria-label="WhatsApp channel"><svg class="ic"><use href="#i-wa"/></svg></a>
        <a href="{{ site.facebook }}" target="_blank" rel="noopener" aria-label="Facebook"><svg class="ic"><use href="#i-fb"/></svg></a>
        <a href="{{ site.instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><svg class="ic"><use href="#i-ig"/></svg></a>
      </div>
    </div>
    <div>
      <h4>Explore</h4>
      <a href="/opportunities/">Opportunities</a>
      <a href="/materials/">Materials</a>
      <a href="/award-notifications/">Award Notifications</a>
      <a href="/saved/">Saved</a>
    </div>
    <div>
      <h4>Company</h4>
      <a href="/about/">About</a>
      <a href="/privacy-policy/">Privacy Policy</a>
      <a href="/feed.xml">RSS feed</a>
    </div>
  </div>
  <div class="wrap footer-bottom">&copy; {{ currentYear }} Scholars Planet. All rights reserved.</div>
</footer>

<script src="/assets/js/app.js" defer></script>
<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
<script>
if (window.netlifyIdentity) {
  window.netlifyIdentity.on("init", function (user) {
    if (!user) { window.netlifyIdentity.on("login", function () { document.location.href = "/admin/"; }); }
  });
}
</script>
</body>
</html>
